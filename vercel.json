{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/app-web/publico/landing/pagina.html" },
    { "source": "/estilos/:path*", "destination": "/app-web/estilos/:path*" },
    { "source": "/landing/:path*", "destination": "/app-web/publico/landing/:path*" },
    { "source": "/legal/:path*", "destination": "/app-web/publico/termos/:path*" },
    { "source": "/termos", "destination": "/app-web/publico/termos/termos-de-uso.html" },
    { "source": "/privacidade", "destination": "/app-web/publico/termos/privacidade.html" },
    { "source": "/reembolso", "destination": "/app-web/publico/termos/reembolso.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(estilos|landing|legal)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
